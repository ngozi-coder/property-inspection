  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon src/index.ts",
    "start": "node dist/index.js",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.js\" \"**/*.json\" \"!node_modules/**\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"src/**/*.js\" \"**/*.json\" \"!node_modules/**\"",
    "lint": "eslint \"src/**/*.ts\" --ext .ts",
    "lint:fix": "eslint \"src/**/*.ts\" --ext .ts --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
